---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Unser Verein – SG Köln-Worringen"
  description="Unser Verein – Informationen und Inhalte der SG Köln-Worringen Fußballabteilung."
>
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumbs">
        <a href={base}>Startseite</a>
        <span class="sep">/</span>
        <a href={`${base}unser-verein/`}>Unser Verein</a>
      </nav>
      <h1>Unser Verein</h1>
    </div>
  </div>

  <div class="page-body">
    <div class="container" style="padding-top: 1rem; padding-bottom: 2rem;">
      <div class="card-grid cols-3">
          <a href={`${base}unser-verein/der-verein/`} class="card is-link">
            <h3>Der Verein</h3>
            <span class="card-link">Mehr erfahren</span>
          </a>
          <a href={`${base}unser-verein/unser-abteilungsleitung/`} class="card is-link">
            <h3>Unser Abteilungsleitung</h3>
            <span class="card-link">Mehr erfahren</span>
          </a>
          <a href={`${base}unser-verein/unser-platzwart/`} class="card is-link">
            <h3>Unser Platzwart</h3>
            <span class="card-link">Mehr erfahren</span>
          </a>
          <a href={`${base}unser-verein/schiedrichter/`} class="card is-link">
            <h3>Schiedrichter</h3>
            <span class="card-link">Mehr erfahren</span>
          </a>
          <a href={`${base}unser-verein/unsere-baba/`} class="card is-link">
            <h3>Unsere BABA</h3>
            <span class="card-link">Mehr erfahren</span>
          </a>
          <a href={`${base}unser-verein/unsere-anlage/`} class="card is-link">
            <h3>Unsere Anlage</h3>
            <span class="card-link">Mehr erfahren</span>
          </a>
          <a href={`${base}unser-verein/vereinsgeschichte/`} class="card is-link">
            <h3>Vereinsgeschichte</h3>
            <span class="card-link">Mehr erfahren</span>
          </a>
          <a href={`${base}unser-verein/anfahrt/`} class="card is-link">
            <h3>Anfahrt</h3>
            <span class="card-link">Mehr erfahren</span>
          </a>
          <a href={`${base}unser-verein/neuigkeiten/`} class="card is-link">
            <h3>Neuigkeiten</h3>
            <span class="card-link">Mehr erfahren</span>
          </a>
      </div>
    </div>
  </div>
</BaseLayout>
