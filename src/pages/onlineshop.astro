---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Onlineshop – SG Köln-Worringen" description="Vereinskleidung bestellen – Trikots, Trainingsanzüge und mehr im offiziellen Shop der SG Köln-Worringen.">
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumbs">
        <a href={base}>Startseite</a>
        <span class="sep">/</span>
        <a href={`${base}onlineshop/`}>Onlineshop</a>
      </nav>
      <h1>Onlineshop</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="shop-card">
        <div class="shop-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
        </div>
        <h2>Vereinskleidung bestellen</h2>
        <p>
          Trikots, Trainingsanzüge und mehr im offiziellen Shop der SG Köln-Worringen.
          Die Bestellung erfolgt direkt über unseren Partner JAKO.
        </p>
        <a
          href="https://team.jako.com/de/sg_koeln-worringen/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary shop-btn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          Zum JAKO-Shop
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .shop-card {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    padding: 3rem 2rem;
    background: #fff;
    border-radius: var(--r-md);
    border: 1px solid var(--border);
  }

  .shop-icon {
    color: var(--blue);
    opacity: 0.6;
    margin-bottom: 1.5rem;
  }

  .shop-card h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .shop-card p {
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .shop-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
