---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Gästebuch – SG Köln-Worringen" description="Hinterlasse uns einen Gruß oder schreib uns auf Instagram!">
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumbs">
        <a href={base}>Startseite</a>
        <span class="sep">/</span>
        <a href={`${base}gaestebuch/`}>Gästebuch</a>
      </nav>
      <h1>Gästebuch</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="placeholder-card">
        <div class="placeholder-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <h2>Gästebuch wird überarbeitet</h2>
        <p>
          Unser Gästebuch wird derzeit überarbeitet. In der Zwischenzeit freuen wir
          uns über Nachrichten auf Instagram!
        </p>
        <a
          href="https://www.instagram.com/sgworringenfussball/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary instagram-btn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
          Auf Instagram folgen
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .placeholder-card {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    padding: 3rem 2rem;
    background: #fff;
    border-radius: var(--r-md);
    border: 1px solid var(--border);
  }

  .placeholder-icon {
    color: var(--blue);
    opacity: 0.6;
    margin-bottom: 1.5rem;
  }

  .placeholder-card h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .placeholder-card p {
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .instagram-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
