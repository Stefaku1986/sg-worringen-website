---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Weitergeben statt wegwerfen – SG Köln-Worringen"
  description="Weitergeben statt wegwerfen – Informationen und Inhalte der SG Köln-Worringen Fußballabteilung."
>
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumbs">
        <a href={base}>Startseite</a>
        <span class="sep">/</span>
        <a href={`${base}fundgrube/`}>Fundgrube</a>
        <span class="sep">/</span>
        <a href={`${base}fundgrube/weitergeben-statt-wegwerfen/`}>Weitergeben Statt Wegwerfen</a>
      </nav>
      <h1>Weitergeben statt wegwerfen</h1>
    </div>
  </div>

  <div class="page-body">
    <div class="page-content reveal">
      <h2 style="text-align: center"><strong>Weitergeben statt wegwerfen</strong><br />Kinder wachsen – Schuhe, Trikots oder Trainingsjacken passen oft nur eine Saison.<br />Statt wegwerfen: Gib gut erhaltene Sachen einfach weiter!<br />Ihr könnt die Kleidung und Ausrüstung jeden Donnerstag von 18:00 bis 19:00 Uhr<br />bei uns am Sportplatz bei Miriam Kühl abgeben.<br />Die Sachen werden gesammelt, sortiert und hier auf der Homepage präsentiert.<br />Wer etwas braucht, kann sich jederzeit direkt an Miriam Kühl wenden – ganz unkompliziert.<br />👉 So entsteht ein Kreislauf, der hilft, spart und nachhaltig wirkt.</h2><div><div><a name="STRATP_cm4all_com_widgets_UroPhoto_54429931"></a></div><div> <img loading="lazy" src="/images/content/sonstiges/weitergebena.png" />
</div></div>
    </div>
  </div>
</BaseLayout>
