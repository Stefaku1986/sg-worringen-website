---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { teams } from '../../lib/teams';
import site from '../../../data/site.json';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Mannschaften & Trainingszeiten – SG Köln-Worringen"
  description="Alle Mannschaften der SG Köln-Worringen im Überblick – von den Bambini bis zur 1. Mannschaft. Aktuelle Trainingszeiten Saison 2025/2026."
>
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumbs">
        <a href={base}>Startseite</a>
        <span class="sep">/</span>
        <a href={`${base}kaderuebersicht/`}>Mannschaften</a>
      </nav>
      <h1>Mannschaften</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Saison {site.season}</span>
        <h2>Alle Mannschaften</h2>
      </div>
      <p class="training-subtitle reveal">
        Alle Trainings finden auf unserer Anlage am <strong>Erdweg 1a, 50769 Köln-Worringen</strong> statt.
        Den vollständigen Wochenplan findest du im <a href={`${base}kaderuebersicht/trainingsplan/`}>Trainingsplan</a>.
      </p>

      <div class="training-grid stagger-children">
        {teams.map((team) => (
          <a href={`${base}kaderuebersicht/${team.slug}/`} class="training-card reveal">
            <div class="training-card-header">
              <span class="age-badge" style={`background: ${team.categoryColor}; color: #fff;`}>
                {team.uNumber || '⚽'}
              </span>
              <div class="team-header-text">
                <span class="team-label">{team.displayName}</span>
                {team.birthYear && <span class="team-year">Jahrgang {team.birthYear}</span>}
              </div>
            </div>

            <div class="training-info">
              <div class="training-row">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                <span>{team.trainer}</span>
              </div>
              <div class="training-row">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span>{team.trainingDays}</span>
              </div>
              <div class="training-row">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span>{team.trainingTime} Uhr</span>
              </div>
            </div>

            <span class="card-link">Zum Kader →</span>
          </a>
        ))}
      </div>

      <div class="cta-center">
        <a href={`${base}kaderuebersicht/trainingsplan/`} class="btn btn-primary">Trainingsplan ansehen</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .training-subtitle {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    font-size: 1rem;
    line-height: 1.6;
  }

  .training-subtitle a {
    color: var(--blue);
    font-weight: 600;
    text-decoration: underline;
  }

  /* ── Training Grid ── */
  .training-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1.25rem;
  }

  .training-card {
    background: var(--surface);
    border-radius: var(--r-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.3s var(--ease-out), transform 0.3s var(--ease-out), border-color 0.3s ease;
  }

  .training-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
    border-color: var(--blue);
    text-decoration: none;
  }

  .training-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .age-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    height: 48px;
    padding: 0 0.5rem;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .team-header-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .team-label {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--blue-deep);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.2;
  }

  .team-year {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* ── Training info ── */
  .training-info {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }

  .training-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .training-row svg {
    color: var(--blue);
    flex-shrink: 0;
  }

  .training-card .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 700;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--blue);
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .cta-center {
    text-align: center;
    margin-top: 2.5rem;
  }

  @media (max-width: 720px) {
    .training-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
