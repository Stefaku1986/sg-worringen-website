---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Downloads & Formulare – SG Köln-Worringen" description="Formulare und Dokumente zum Download – Aufnahmeanträge, Datenschutzformulare und mehr.">
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumbs">
        <a href={base}>Startseite</a>
        <span class="sep">/</span>
        <a href={`${base}mitmachen/`}>Mitmachen</a>
        <span class="sep">/</span>
        <a href={`${base}mitmachen/downloads-formulare/`}>Downloads & Formulare</a>
      </nav>
      <h1>Downloads & Formulare</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="placeholder-card">
        <div class="placeholder-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
        <h2>Dokumente in Vorbereitung</h2>
        <p>
          Hier findest du in Kürze Formulare und Dokumente zum Download – z.&thinsp;B.
          Aufnahmeanträge, Datenschutzformulare und mehr.
        </p>
        <div class="contact-hint">
          <span>Bei Fragen wende dich an:</span>
          <a href="mailto:Info@sg-fussball.online">Info@sg-fussball.online</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .placeholder-card {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    padding: 3rem 2rem;
    background: #fff;
    border-radius: var(--r-md);
    border: 1px solid var(--border);
  }

  .placeholder-icon {
    color: var(--blue);
    opacity: 0.6;
    margin-bottom: 1.5rem;
  }

  .placeholder-card h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .placeholder-card p {
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .contact-hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.95rem;
  }

  .contact-hint span {
    color: var(--text-muted);
  }

  .contact-hint a {
    color: var(--blue);
    font-weight: 600;
    text-decoration: none;
  }

  .contact-hint a:hover {
    text-decoration: underline;
  }
</style>
