---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const contact = {
  name: 'Michael Paffendorf',
  role: 'Ansprechpartner BABA',
  email: 'paffy2704@gmail.com',
  phone: '015143250312',
};

const images = [
  {
    src: `${base}images/content/BABA/BABA1.PNG`,
    alt: 'BABA Umbau - Ansicht 1',
  },
  {
    src: `${base}images/content/BABA/BABAB555.PNG`,
    alt: 'BABA Umbau - Ansicht 2',
  },
  {
    src: `${base}images/content/BABA/BABA3.PNG`,
    alt: 'BABA Umbau - Ansicht 3',
  },
  {
    src: `${base}images/content/BABA/BABA4.PNG`,
    alt: 'BABA Umbau - Ansicht 4',
  },
  {
    src: `${base}images/content/BABA/BABAB5.PNG`,
    alt: 'BABA Umbau - Ansicht 5',
  },
];
---

<BaseLayout title="Unsere BABA – SG Köln-Worringen" description="Die BABA der SG Köln-Worringen – unser Vereinstreffpunkt wird umgebaut. Bilder vom Umbau und Ansprechpartner.">
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumbs">
        <a href={base}>Startseite</a>
        <span class="sep">/</span>
        <a href={`${base}unser-verein/`}>Unser Verein</a>
        <span class="sep">/</span>
        <a href={`${base}unser-verein/unsere-baba/`}>Unsere BABA</a>
      </nav>
      <h1>Unsere BABA</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Vereinsleben</span>
        <h2>Der Umbau unserer BABA</h2>
      </div>

      <p class="intro-text">
        Unsere BABA ist das Herzstück des Vereinslebens — der Ort, an dem sich Spieler, Trainer und Mitglieder nach Training und Spieltagen zusammenfinden. Um diesen wichtigen Treffpunkt noch einladender zu gestalten, haben wir mit dem Umbau begonnen. Hier dokumentieren wir den Fortschritt der Renovierung in Bildern.
      </p>

      <div class="gallery">
        {images.map((img) => (
          <div class="gallery-item">
            <img src={img.src} alt={img.alt} loading="lazy" />
          </div>
        ))}
      </div>

      <div class="contact-card">
        <span class="contact-role">{contact.role}</span>
        <h3>{contact.name}</h3>
        <div class="contact-details">
          <a href={`tel:+49${contact.phone.replace(/^0/, '')}`} class="contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>{contact.phone}</span>
          </a>
          <a href={`mailto:${contact.email}`} class="contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span>{contact.email}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .intro-text {
    max-width: 720px;
    margin: 0 auto 3rem;
    text-align: center;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-muted);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .gallery-item {
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--blue-soft);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.03);
  }

  .contact-card {
    max-width: 480px;
    margin: 0 auto;
    background: white;
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
  }

  .contact-role {
    display: inline-block;
    background: var(--blue-soft);
    color: var(--blue);
    border-radius: var(--r-pill);
    padding: 0.25rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .contact-card h3 {
    font-size: 1.35rem;
    margin-bottom: 1rem;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .contact-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a.contact-item:hover {
    color: var(--blue);
  }

  .contact-item svg {
    flex-shrink: 0;
    color: var(--blue);
    opacity: 0.7;
  }

  @media (max-width: 900px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .gallery {
      grid-template-columns: 1fr;
    }

    .contact-card {
      padding: 1.5rem;
    }
  }
</style>
