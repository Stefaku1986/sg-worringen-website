---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const address = {
  street: 'Erdweg 1a',
  zip: '50769',
  city: 'Köln (Worringen)',
};

const infoCards = [
  {
    title: 'Mit dem Auto',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 16H9m10 0h3v-3.15a1 1 0 0 0-.84-.99L16 11l-2.7-3.6a1 1 0 0 0-.8-.4H5.24a2 2 0 0 0-1.8 1.1l-.8 1.63A6 6 0 0 0 2 12.42V16h2"/><circle cx="6.5" cy="16.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/></svg>`,
    text: 'Die Anfahrt erfolgt über die Neusser Landstraße (L183). Parkmöglichkeiten sind direkt an der Anlage vorhanden – bitte die Beschilderung beachten.',
  },
  {
    title: 'Mit der S-Bahn',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="16" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="m8 19-2 3"/><path d="m18 22-2-3"/><path d="M8 15h0"/><path d="M16 15h0"/></svg>`,
    text: 'Ab Köln Hbf mit der S-Bahn Linie S11 bis Köln-Worringen. Von dort sind es ca. 10–15 Minuten Fußweg zur Anlage. Alternativ fahren Buslinien (Linie 120) bis in die Nähe – Haltestelle Üdesheimer Weg.',
  },
  {
    title: 'Navi-Tipp',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,
    text: 'Bitte „Erdweg 1a, 50769 Köln" in dein Navigationsgerät eingeben.',
  },
];
---

<BaseLayout title="Anfahrt – SG Köln-Worringen" description="Anfahrt zur Sportanlage am Erdweg, 50769 Köln-Worringen. Mit dem Auto, S-Bahn oder Bus – so findest du uns.">
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumbs">
        <a href={base}>Startseite</a>
        <span class="sep">/</span>
        <a href={`${base}unser-verein/`}>Unser Verein</a>
        <span class="sep">/</span>
        <a href={`${base}unser-verein/anfahrt/`}>Anfahrt</a>
      </nav>
      <h1>Anfahrt</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Standort</span>
        <h2>So findest du uns</h2>
      </div>

      <div class="address-card">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <div>
          <strong>Sportanlage am Erdweg</strong>
          <span>{address.street}, {address.zip} {address.city}</span>
        </div>
      </div>

      <div class="map-wrap">
        <iframe
          src="https://www.openstreetmap.org/export/embed.html?bbox=6.8550%2C51.0290%2C6.8750%2C51.0390&layer=mapnik&marker=51.0340%2C6.8650"
          width="100%"
          height="400"
          style="border: 1px solid var(--border); border-radius: 0.75rem;"
          loading="lazy"
          title="Standort Sportanlage am Erdweg"
        ></iframe>
      </div>

      <div class="card-grid cols-3 info-grid">
        {infoCards.map((card) => (
          <div class="card info-card">
            <div class="info-icon" set:html={card.icon} />
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .address-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--blue-soft);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.5rem 2rem;
    margin-bottom: 2rem;
    max-width: 480px;
    margin-inline: auto;
  }

  .address-card svg {
    flex-shrink: 0;
    color: var(--blue);
  }

  .address-card div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .address-card strong {
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .address-card span {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .map-wrap {
    margin-bottom: 3rem;
  }

  .map-wrap iframe {
    display: block;
  }

  .info-grid {
    gap: 1.5rem;
  }

  .info-card {
    padding: 2rem;
    text-align: center;
  }

  .info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: var(--blue-soft);
    color: var(--blue);
    border-radius: 50%;
    margin-bottom: 1rem;
  }

  .info-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
  }

  .info-card p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .address-card {
      padding: 1.25rem 1.5rem;
    }

    .info-card {
      padding: 1.5rem;
    }
  }
</style>
