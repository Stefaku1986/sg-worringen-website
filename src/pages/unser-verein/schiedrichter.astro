---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const profile = {
  name: 'Paul Kühl',
  role: 'Schiedsrichter',
  geburtsdatum: '15. Juni 2011',
  wohnort: 'Köln-Worringen',
  schule: '8. Klasse, Realschule',
  portrait: `${base}images/content/Schiedsrichter/p.jpeg`,
  karriere: [
    { verein: 'SG Worringen (Jugend)', aktuell: false },
    { verein: 'Vds Nievenheim', aktuell: false },
    { verein: 'SSV Roggendorf', aktuell: false },
    { verein: 'U15 der SG Worringen', aktuell: true },
  ],
  warumSchiedsrichter:
    'Paul bringt ein gutes Spielverständnis mit, kennt den Jugendfußball aus eigener Erfahrung und bleibt in hitzigen Situationen ruhig – beste Voraussetzungen für einen jungen, motivierten Referee. Wir sind stolz, Paul in unseren Reihen zu haben – auf dem Platz als Spieler und daneben als Schiedsrichter.',
  gallery: [
    `${base}images/content/Schiedsrichter/924c03e3-1821-4564-aade-2510c2e59c37.jpeg`,
    `${base}images/content/Schiedsrichter/099f2302-5394-4358-9ba0-7dd3ba49c0a6.jpeg`,
    `${base}images/content/Schiedsrichter/pau.jpeg`,
    `${base}images/content/Schiedsrichter/pfeife_1.png`,
  ],
};
---

<BaseLayout title="Unsere Schiedsrichter – SG Köln-Worringen" description="Schiedsrichter-Steckbrief: Paul Kühl – junger Referee der SG Köln-Worringen mit Spielverständnis und Leidenschaft.">
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumbs">
        <a href={base}>Startseite</a>
        <span class="sep">/</span>
        <a href={`${base}unser-verein/`}>Unser Verein</a>
        <span class="sep">/</span>
        <a href={`${base}unser-verein/schiedrichter/`}>Schiedsrichter</a>
      </nav>
      <h1>Unsere Schiedsrichter</h1>
    </div>
  </div>

  <!-- Profile Section -->
  <section class="section">
    <div class="container">
      <div class="profile-layout">
        <div class="portrait-wrapper">
          <img
            src={profile.portrait}
            alt={`Portrait von ${profile.name}`}
            class="portrait-img"
            loading="lazy"
          />
        </div>
        <div class="profile-info">
          <span class="role-badge">{profile.role}</span>
          <h2>{profile.name}</h2>
          <p class="steckbrief-label">Schiedsrichter-Steckbrief</p>
          <dl class="info-list">
            <div class="info-row">
              <dt>Geburtsdatum</dt>
              <dd>{profile.geburtsdatum}</dd>
            </div>
            <div class="info-row">
              <dt>Wohnort</dt>
              <dd>{profile.wohnort}</dd>
            </div>
            <div class="info-row">
              <dt>Schule</dt>
              <dd>{profile.schule}</dd>
            </div>
            <div class="info-row">
              <dt>Fußball</dt>
              <dd>Spielt seit seinem 6. Lebensjahr Fußball</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Karriere Timeline -->
  <section class="section section-tinted">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Karriere</span>
        <h2>Fußball-Laufbahn</h2>
      </div>
      <div class="timeline">
        {profile.karriere.map((station, i) => (
          <div class:list={['timeline-item', { 'is-current': station.aktuell }]}>
            <div class="timeline-marker">
              <span class="marker-dot" />
              {i < profile.karriere.length - 1 && <span class="marker-line" />}
            </div>
            <div class="timeline-content">
              {station.aktuell && <span class="current-badge">Aktuell</span>}
              <span class="timeline-club">{station.verein}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Warum Schiedsrichter -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Motivation</span>
        <h2>Warum Schiedsrichter?</h2>
      </div>
      <div class="motivation-text">
        <p>{profile.warumSchiedsrichter}</p>
      </div>
    </div>
  </section>

  <!-- Photo Gallery -->
  <section class="section section-tinted">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Impressionen</span>
        <h2>Galerie</h2>
      </div>
      <div class="gallery-grid">
        {profile.gallery.map((src, i) => (
          <div class="gallery-item">
            <img
              src={src}
              alt={`${profile.name} – Bild ${i + 2}`}
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Profile Layout ── */
  .profile-layout {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .portrait-wrapper {
    position: sticky;
    top: 6rem;
  }

  .portrait-img {
    width: 100%;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-md);
    object-fit: cover;
    aspect-ratio: 3 / 4;
  }

  .role-badge {
    display: inline-block;
    background: var(--blue-soft);
    color: var(--blue);
    border-radius: var(--r-pill);
    padding: 0.25rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .profile-info h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    margin: 0.25rem 0 0.25rem;
    color: var(--blue);
  }

  .steckbrief-label {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0 0 1.5rem;
  }

  /* ── Info List ── */
  .info-list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .info-row {
    display: flex;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .info-row:first-child {
    border-top: 1px solid var(--border);
  }

  .info-row dt {
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-muted);
    min-width: 120px;
    flex-shrink: 0;
  }

  .info-row dd {
    margin: 0;
    font-size: 0.95rem;
  }

  /* ── Timeline ── */
  .timeline {
    max-width: 500px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    display: flex;
    gap: 1.25rem;
    position: relative;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 20px;
  }

  .marker-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--blue-soft);
    border: 3px solid var(--blue);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .is-current .marker-dot {
    background: var(--yellow);
    border-color: var(--blue);
    box-shadow: 0 0 0 4px var(--yellow-glow);
  }

  .marker-line {
    width: 2px;
    flex: 1;
    background: var(--border);
    min-height: 2rem;
  }

  .timeline-content {
    padding-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0;
  }

  .timeline-item:last-child .timeline-content {
    padding-bottom: 0;
  }

  .current-badge {
    display: inline-block;
    background: var(--yellow);
    color: var(--blue-deep);
    border-radius: var(--r-pill);
    padding: 0.15rem 0.65rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    align-self: flex-start;
  }

  .timeline-club {
    font-size: 1.05rem;
    font-weight: 500;
  }

  .is-current .timeline-club {
    font-weight: 700;
    color: var(--blue);
  }

  /* ── Motivation ── */
  .motivation-text {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .motivation-text p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-muted);
  }

  /* ── Gallery ── */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .gallery-item {
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease;
  }

  .gallery-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .gallery-item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .profile-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .portrait-wrapper {
      position: static;
      max-width: 280px;
      margin: 0 auto;
    }

    .profile-info h2 {
      font-size: 1.6rem;
    }

    .info-row {
      flex-direction: column;
      gap: 0.25rem;
    }

    .info-row dt {
      min-width: 0;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .motivation-text p {
      font-size: 1rem;
      text-align: left;
    }
  }
</style>
