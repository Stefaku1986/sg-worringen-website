---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Fundgrube – SG Köln-Worringen"
  description="Fundgrube – Informationen und Inhalte der SG Köln-Worringen Fußballabteilung."
>
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumbs">
        <a href={base}>Startseite</a>
        <span class="sep">/</span>
        <a href={`${base}fundgrube/`}>Fundgrube</a>
      </nav>
      <h1>Fundgrube</h1>
    </div>
  </div>

  <div class="page-body">
    <div class="container" style="padding-top: 1rem; padding-bottom: 2rem;">
      <div class="card-grid cols-2">
          <a href={`${base}fundgrube/gefunden-verloren/`} class="card is-link">
            <h3>„Gefunden & verloren“</h3>
            <span class="card-link">Mehr erfahren</span>
          </a>
          <a href={`${base}fundgrube/weitergeben-statt-wegwerfen/`} class="card is-link">
            <h3>Weitergeben statt wegwerfen</h3>
            <span class="card-link">Mehr erfahren</span>
          </a>
      </div>
    </div>
  </div>
</BaseLayout>
